#!/usr/bin/env bash
# Start the bridge and run Voicemod.
set -euo pipefail

root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
export WINEPREFIX=${WINEPREFIX:-"$root/prefix"}
export WINESERVER="$root/wine-build/server/wineserver"
export WINEDEBUG=${WINEDEBUG:--all}
export QTWEBENGINE_DISABLE_SANDBOX=1
export QTWEBENGINE_CHROMIUM_FLAGS="${QTWEBENGINE_CHROMIUM_FLAGS:-} --no-sandbox"

"$root/scripts/voicemod-bridge" start
"$root/wine-build/wine" 'C:\Program Files\Voicemod V3\Voicemod.exe' "$@" || true
"$WINESERVER" -w
