#!/usr/bin/env bash
# Fetch Wine, apply wine.patch and build it.
set -euo pipefail

root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
commit=3ec14378590503ffbadfa936b994e5bf849fe967

if [[ ! -d "$root/wine/.git" ]]; then
    git init -q "$root/wine"
    git -C "$root/wine" fetch -q --depth 1 https://gitlab.winehq.org/wine/wine.git "$commit"
    git -C "$root/wine" checkout -q FETCH_HEAD
    git -C "$root/wine" apply "$root/wine.patch"
    (cd -- "$root/wine" && autoconf)
fi

mkdir -p -- "$root/wine-build"
cd -- "$root/wine-build"
../wine/configure --enable-win64 --disable-tests
make -j"$(nproc)"
