#!/usr/bin/env bash
# Set up Voicemod on Linux from Voicemod's Windows installer.
#
#   setup /path/to/VoicemodInstaller.exe    full setup
#   setup                                   refresh an existing setup
#   setup --prebuilt [installer]            download Wine instead of building it
#   setup --rebuild-wine [installer]        rebuild Wine even if up to date
#   setup --wine-only                       only fetch and build Wine
#
# Builds Wine (first run only), creates the Wine prefix, runs the
# installer, and adds Voicemod to the application menu.  Safe to run again.
set -euo pipefail

# shellcheck source=lib/common.sh
source "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/lib/common.sh"

rebuild=0
prebuilt=0
wine_only=0
installer=
for arg in "$@"; do
    case "$arg" in
        -h|--help) sed -n '2,11p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 0 ;;
        --prebuilt) prebuilt=1 ;;
        --rebuild-wine) rebuild=1 ;;
        --wine-only) wine_only=1 ;;
        -*) die "Unknown option: $arg" ;;
        *) installer=$arg ;;
    esac
done
if [[ -n "$installer" ]]; then
    [[ -f "$installer" ]] || die "Installer not found: $installer"
    installer=$(readlink -f -- "$installer")
    # Windows programs start with the bytes "MZ".
    [[ "$(head -c 2 -- "$installer" | tr -d '\0')" == MZ ]] ||
        die "Not a Windows installer: $installer
Pass the VoicemodInstaller .exe downloaded from voicemod.net."
fi

check_tools()
{
    local missing=() tool tools=(git pactl flock iconv curl tar sha256sum)

    if ((prebuilt)); then tools+=(xz)
    else tools+=(make gcc bison flex x86_64-w64-mingw32-gcc i686-w64-mingw32-gcc)
    fi
    for tool in "${tools[@]}"; do
        command -v "$tool" >/dev/null || missing+=("$tool")
    done
    ((${#missing[@]})) || return 0
    if ((prebuilt)); then
        die "Missing tools: ${missing[*]}
$runtime_packages"
    fi
    die "Missing tools: ${missing[*]}
On Debian, Ubuntu, Mint:  sudo apt install git build-essential bison flex gcc-mingw-w64 \\
    g++-mingw-w64 pulseaudio-utils util-linux curl libpulse-dev libgnutls28-dev \\
    libvulkan-dev libfreetype-dev libfontconfig-dev libgl-dev libegl-dev \\
    libx11-dev libxext-dev libxcomposite-dev libxcursor-dev libxfixes-dev \\
    libxi-dev libxinerama-dev libxrandr-dev libxrender-dev libxxf86vm-dev \\
    libxkbcommon-dev libwayland-dev libasound2-dev libdbus-1-dev libudev-dev \\
    libavcodec-dev libavformat-dev libavutil-dev ocl-icd-opencl-dev
On Fedora:                sudo dnf install git gcc make bison flex mingw64-gcc mingw32-gcc \\
    mingw64-gcc-c++ mingw32-gcc-c++ pulseaudio-utils util-linux curl \\
    pulseaudio-libs-devel gnutls-devel vulkan-loader-devel freetype-devel \\
    fontconfig-devel mesa-libGL-devel mesa-libEGL-devel libX11-devel libXext-devel \\
    libXcomposite-devel libXcursor-devel libXfixes-devel libXi-devel \\
    libXinerama-devel libXrandr-devel libXrender-devel libXxf86vm-devel \\
    libxkbcommon-devel wayland-devel alsa-lib-devel dbus-devel systemd-devel \\
    ffmpeg-free-devel ocl-icd-devel
On Arch, CachyOS:         sudo pacman -S --needed base-devel git mingw-w64-gcc libpulse gnutls \\
    vulkan-headers vulkan-icd-loader freetype2 fontconfig mesa libglvnd libx11 \\
    libxext libxcomposite libxcursor libxfixes libxi libxinerama libxrandr \\
    libxrender libxxf86vm libxkbcommon wayland alsa-lib dbus systemd-libs ffmpeg \\
    opencl-headers ocl-icd
Or use --prebuilt, which needs no build tools."
}

# The Wine commit this version of the repository expects.
# The libraries the prebuilt Wine loads for Voicemod: fonts, X11, Vulkan,
# OpenGL, TLS, PulseAudio and D-Bus.  Wine starts without them but shows
# blank text or crashes.  Package names verified 2026-09-30.
runtime_libraries=(libfreetype.so.6 libfontconfig.so.1 libgnutls.so.30 libvulkan.so.1
    libpulse.so.0 libdbus-1.so.3 libGL.so.1 libEGL.so.1 libX11.so.6 libXext.so.6
    libXcomposite.so.1 libXcursor.so.1 libXfixes.so.3 libXinerama.so.1 libXi.so.6
    libXrandr.so.2 libXrender.so.1 libXxf86vm.so.1)
runtime_packages="On Debian, Ubuntu, Mint:  sudo apt install git curl xz-utils pulseaudio-utils util-linux \\
    libfreetype6 libfontconfig1 libgnutls30t64 libvulkan1 libpulse0 libdbus-1-3 \\
    libgl1 libegl1 libx11-6 libxext6 libxcomposite1 libxcursor1 libxfixes3 \\
    libxinerama1 libxi6 libxrandr2 libxrender1 libxxf86vm1
On Fedora:                sudo dnf install git curl xz pulseaudio-utils util-linux \\
    freetype fontconfig gnutls vulkan-loader pulseaudio-libs dbus-libs \\
    mesa-libGL mesa-libEGL libX11 libXext libXcomposite libXcursor libXfixes \\
    libXinerama libXi libXrandr libXrender libXxf86vm
On Arch, CachyOS:         sudo pacman -S --needed git curl xz libpulse util-linux \\
    freetype2 fontconfig gnutls vulkan-icd-loader dbus libglvnd libx11 libxext \\
    libxcomposite libxcursor libxfixes libxinerama libxi libxrandr libxrender \\
    libxxf86vm"

check_runtime_libraries()
{
    local ldconfig missing=() lib cache

    for ldconfig in ldconfig /sbin/ldconfig /usr/sbin/ldconfig; do
        cache=$("$ldconfig" -p 2>/dev/null) && break
    done
    [[ -n "$cache" ]] || { warn "Could not list the system libraries; skipping the check."; return; }
    for lib in "${runtime_libraries[@]}"; do
        grep -q -F "$lib " <<<"$cache" || missing+=("$lib")
    done
    ((${#missing[@]})) || return 0
    die "Missing system libraries: ${missing[*]}
$runtime_packages"
}

# The version of Wine this version of the repository is made for.
wine_commit()
{
    git -C "$vm_root" ls-tree HEAD wine | awk '{ print $3 }'
}

wine_is_current()
{
    ((!rebuild)) && [[ -x "$wine_bin" && "$(cat "$wine_build/.voicemod-stamp" 2>/dev/null)" == "$1" ]]
}

fetch_wine()
{
    local commit archive="$vm_root/wine-prebuilt.tar.xz"
    local prebuilt_commit= prebuilt_url= prebuilt_sha256=

    commit=$(wine_commit)
    if wine_is_current "$commit"; then
        say "Wine is up to date"
        check_runtime_libraries
        return
    fi

    # shellcheck source=/dev/null
    [[ -f "$vm_root/wine-prebuilt" ]] && source "$vm_root/wine-prebuilt"
    [[ "$prebuilt_commit" == "$commit" ]] ||
        die "No prebuilt Wine is published for this version. Run $0 without
--prebuilt to build it instead."

    say "Downloading Wine"
    curl -fL --progress-bar -o "$archive" "${VOICEMOD_PREBUILT_URL:-$prebuilt_url}" ||
        die "Could not download the prebuilt Wine."
    if ! printf '%s  %s\n' "$prebuilt_sha256" "$archive" | sha256sum -c --status; then
        rm -f -- "$archive"
        die "The prebuilt Wine does not match its expected checksum."
    fi
    rm -rf -- "$wine_build"
    mkdir -p -- "$wine_build"
    tar -xJf "$archive" -C "$wine_build" || die "Could not unpack the prebuilt Wine."
    rm -f -- "$archive"
    printf '%s\n' "$commit" >"$wine_build/.voicemod-stamp"
    wine_paths
    "$wine_bin" --version >/dev/null 2>&1 ||
        die "The prebuilt Wine does not run on this system, which is probably
older than the one it was built on. Run $0 --rebuild-wine to build it instead."
    check_runtime_libraries
}

build_wine()
{
    local stamp jobs=${JOBS:-$(nproc)}

    stamp=$(wine_commit)
    # A Wine source that is on a branch is being worked on and is built as it
    # is.  Otherwise it is at the version it was fetched at: 'git pull' does
    # not update it.
    if [[ -e "$wine_src/.git" ]] && git -C "$wine_src" symbolic-ref -q HEAD >/dev/null; then
        if [[ "$(git -C "$wine_src" rev-parse HEAD)" != "$stamp" ]]; then
            stamp=$(git -C "$wine_src" rev-parse HEAD)
            warn "Building the Wine source in $wine_src as it is, which is not the
version this repository is made for. To get that version, run:
    git -C $vm_root submodule update --init --depth 1 wine"
        fi
    fi
    if wine_is_current "$stamp"; then
        say "Wine is up to date"
        return
    fi
    if [[ ! -f "$wine_src/configure" || "$(git -C "$wine_src" rev-parse HEAD)" != "$stamp" ]]; then
        say "Fetching Wine"
        git -C "$vm_root" submodule update --init --depth 1 wine ||
            die "Could not fetch the Wine source. This directory must be a git clone:
    git clone --recursive https://github.com/Hamilt79/linux-voicemod"
    fi
    [[ -d "$wine_src/dlls/winevoicemod.sys" ]] ||
        die "The Wine source in $wine_src does not have the Voicemod changes.
To get the version this repository is made for, run:
    git -C $vm_root submodule update --init --depth 1 wine"

    say "Building Wine with $jobs jobs (10 to 30 minutes the first time)"
    rm -rf -- "$wine_build"
    mkdir -p -- "$wine_build"
    (
        cd -- "$wine_build"
        "$wine_src/configure" --enable-archs=i386,x86_64 --disable-tests
        make -j"$jobs"
    ) >"$log_dir/wine-build.log" 2>&1 ||
        die "The Wine build failed. See $log_dir/wine-build.log"

    [[ -f "$wine_build/dlls/winepulse.drv/winepulse.so" ]] ||
        die "Wine was built without PulseAudio support. Install the libpulse
development package, then run: $0 --rebuild-wine"
    grep -q -E 'lib(gnutls|vulkan)[^ ]* .*not found' "$log_dir/wine-build.log" &&
        warn "Wine was built without GnuTLS or Vulkan; Voicemod needs both. See $log_dir/wine-build.log"
    printf '%s\n' "$stamp" >"$wine_build/.voicemod-stamp"
    wine_paths
}

create_prefix()
{
    say "Preparing the Wine prefix in $WINEPREFIX"
    mkdir -p -- "$WINEPREFIX"
    # --init skips the prefix's startup programs: Voicemod registers itself as
    # one, and would otherwise start from inside setup.  mscoree and mshtml
    # are disabled to skip the prompts to download Mono and Gecko.
    WINEDLLOVERRIDES="$WINEDLLOVERRIDES;mscoree=d;mshtml=d" vm_wine wineboot --init --update >/dev/null 2>&1 ||
        die "Could not initialise the Wine prefix."
    "$WINESERVER" -w
}

run_installer()
{
    local copy="$WINEPREFIX/drive_c/voicemod-installer.exe"

    say "Running the Voicemod installer (its progress window will appear)"
    install -m 0755 -- "$installer" "$copy"
    # /SILENT avoids the installer's final page, which hangs under Wine.
    vm_wine 'C:\voicemod-installer.exe' \
        /SILENT /NORESTART /SUPPRESSMSGBOXES '/LOG=C:\voicemod-install.log' \
        >"$log_dir/installer.log" 2>&1 || true
    # The installer starts Voicemod when it finishes; close it so the first
    # real launch goes through the launcher and gets its audio devices.
    "$WINESERVER" -k 2>/dev/null || true
    "$WINESERVER" -w 2>/dev/null || true
    rm -f -- "$copy"
    [[ -f "$app_unix" ]] ||
        die "The installer did not install Voicemod. See $WINEPREFIX/drive_c/voicemod-install.log"
}

install_desktop_entry()
{
    local apps="${XDG_DATA_HOME:-$HOME/.local/share}/applications"
    local entry="$apps/voicemod-linux.desktop" icon=audio-input-microphone stale

    say "Adding Voicemod to the application menu"
    mkdir -p -- "$apps"
    if command -v magick >/dev/null || command -v convert >/dev/null; then
        local ico="$WINEPREFIX/drive_c/Program Files/Voicemod V3/voicemod.ico" tool=convert
        command -v magick >/dev/null && tool=magick
        if [[ -f "$ico" ]] && "$tool" "${ico}[0]" -resize 256x256 "$vm_root/voicemod.png" 2>/dev/null; then
            icon="$vm_root/voicemod.png"
        fi
    fi
    cat >"$entry" <<EOF
[Desktop Entry]
Type=Application
Name=Voicemod
Comment=Real-time voice changer
Exec="$vm_root/voicemod" %u
Icon=$icon
Categories=AudioVideo;Audio;
MimeType=x-scheme-handler/voicemod;
StartupWMClass=voicemod.exe
Terminal=false
EOF
    # Entries written by other Wine installations point at prefixes and
    # commands that do not run this build, and would swallow the login link.
    for stale in "$apps"/wine-protocol-voicemod.desktop; do
        [[ -f "$stale" ]] || continue
        mkdir -p -- "$vm_root/backup"
        mv -f -- "$stale" "$vm_root/backup/$(basename -- "$stale").$(date +%s)"
    done
    command -v update-desktop-database >/dev/null && update-desktop-database "$apps" 2>/dev/null || true
    command -v xdg-mime >/dev/null && xdg-mime default voicemod-linux.desktop x-scheme-handler/voicemod 2>/dev/null || true
}

check_tools
mkdir -p -- "$log_dir"
if ((prebuilt)); then fetch_wine; else build_wine; fi
((wine_only)) && exit 0
create_prefix
say "Installing DXVK $dxvk_version"
dxvk_install
if [[ -n "$installer" ]]; then
    run_installer
elif [[ ! -f "$app_unix" ]]; then
    die "Voicemod is not installed yet. Run: $0 /path/to/VoicemodInstaller.exe"
fi
driver_register
"$WINESERVER" -w 2>/dev/null || true
install_desktop_entry

say "Done. Start Voicemod from the application menu, or run: $vm_root/voicemod"
